# Kopieren nach .env und Werte setzen (.env ist in .gitignore)

# --- KI: „Automatisch erkennen“ (Listing-Fotos) ---
# Mindestens einer: ANTHROPIC_API_KEY und/oder GEMINI_API_KEY (Google AI Studio / Vertex mit passendem Key).
# Ohne beide Keys: lokal Demo-Daten, in Produktion HTTP 503.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Wie REST v1beta/models/gemini-flash-latest; Alternativen: gemini-2.0-flash, gemini-1.5-flash
# CARD_AI_PROVIDER=auto
#   auto     = zuerst Anthropic (wenn Key), bei Fehler Gemini (wenn Key)
#   anthropic= nur Anthropic
#   gemini   = nur Gemini

# --- JWT / Server (bestehend) ---
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# PORT=3000
#
# Reverse-Proxy / Rate-Limit: Auf Railway & Co. automatisch 1 Hop.
# Lokal ohne Proxy ggf. TRUST_PROXY=0 setzen, falls ein Client X-Forwarded-For mitschickt.
# TRUST_PROXY=1

# --- SMTP (Hostinger: ausgehend SSL, Port 465) ---
# Beispiel Hostinger:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=hello@deine-domain.tld
#   SMTP_PASS=dein-app-passwort
#   SMTP_FROM=hello@deine-domain.tld
#   SMTP_FROM_NAME=VUREX

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=VUREX
