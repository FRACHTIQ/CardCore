# Kopieren nach .env und Werte setzen (.env ist in .gitignore)

# --- KI: „Automatisch erkennen“ (Listing-Fotos) ---
# Ohne Key: lokal Demo-Daten, in Produktion HTTP 503.
# ANTHROPIC_API_KEY=
# Optional: Modell-ID laut https://docs.anthropic.com/ (bei 404 am Modell anpassen)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Bei „Modell nicht gefunden“: in der Anthropic-Konsole die aktuelle Vision-Modell-ID eintragen.

# --- JWT / Server (bestehend) ---
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# PORT=3000
#
# Reverse-Proxy / Rate-Limit: Auf Railway & Co. automatisch 1 Hop.
# Lokal ohne Proxy ggf. TRUST_PROXY=0 setzen, falls ein Client X-Forwarded-For mitschickt.
# TRUST_PROXY=1

# --- SMTP (Hostinger: ausgehend SSL, Port 465) ---
# Beispiel Hostinger:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=hello@deine-domain.tld
#   SMTP_PASS=dein-app-passwort
#   SMTP_FROM=hello@deine-domain.tld
#   SMTP_FROM_NAME=VUREX

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=VUREX
