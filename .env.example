PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=

# Optional: kommaseparierte erlaubte Origins (z. B. Web-Admin). Leer = alle Origins (wie bisher).
# CORS_ORIGINS=https://app.example.com,http://localhost:8081

# In Produktion ohne ANTHROPIC_API_KEY liefert /api/ai/analyze 503 (kein stiller Demo-Modus).

# Trading: ohne Verifizierung (nur Entwicklung)
# ALLOW_UNVERIFIED_TRADING=1

# Willkommens-DM (0 = aus). Absender: Standard User id 1, sonst:
# WELCOME_SENDER_USER_ID=1
# WELCOME_DM_ENABLED=1

# Push: 0 = aus
# PUSH_NEW_LISTING_ENABLED=1
# Angebote / Deal-Versand (Expo)
# PUSH_OFFERS_DEALS_ENABLED=1
